HOST=0.0.0.0
PORT=1338

# Fresh app DB (created on first `npm run db:setup`)
DATABASE_URL=postgresql://strapi:strapi@localhost:5433/tygamart?schema=public

# Required in production — change these
JWT_SECRET=change-me-tiger-admin-jwt-secret

# Permanent owner (created/synced on every server start)
ADMIN_EMAIL=admin@tygamart.com
ADMIN_PASSWORD=change-me-owner-password
ADMIN_NAME=TygaMart Owner

SEED_DATA=true

# Optional Cloudinary (leave unset to store under /uploads)
# CLOUDINARY_NAME=
# CLOUDINARY_KEY=
# CLOUDINARY_SECRET=

CORS_ORIGIN=http://localhost:3000
