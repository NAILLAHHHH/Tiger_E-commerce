# TygaMart Node API (admin_side_node) — catalog + orders
# Local: http://localhost:1338
NEXT_PUBLIC_STRAPI_URL=http://localhost:1338

# Public storefront URL (used in WhatsApp order links). In production set your real https domain.
# NEXT_PUBLIC_SITE_URL=https://your-shop.com

# Set to "false" to load catalog from the API instead of mock data
NEXT_PUBLIC_USE_MOCK_DATA=false

# Legacy Supabase (optional — only used if mock is off and API URL is unset)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
