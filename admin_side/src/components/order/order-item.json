{
  "collectionName": "components_order_order_items",
  "info": {
    "displayName": "Product in order",
    "description": "One product the customer ordered"
  },
  "options": {},
  "attributes": {
    "product_name": {
      "type": "string",
      "required": true,
      "description": "Product name"
    },
    "size": {
      "type": "string",
      "description": "Legacy size — prefer options_snapshot"
    },
    "color": {
      "type": "string",
      "description": "Legacy color — prefer options_snapshot"
    },
    "options_snapshot": {
      "type": "json",
      "description": "Chosen options at order time, e.g. [{\"name\":\"Size\",\"value\":\"M\"},{\"name\":\"Color\",\"value\":\"Black\"}]"
    },
    "item_code": {
      "type": "string",
      "description": "Your item code for this SKU"
    },
    "how_many": {
      "type": "integer",
      "required": true,
      "min": 1,
      "description": "How many units"
    },
    "price_each": {
      "type": "decimal",
      "required": true,
      "description": "Price for one unit (RWF)"
    },
    "bought_as": {
      "type": "enumeration",
      "enum": ["one_piece", "many_pieces"],
      "default": "one_piece",
      "description": "Did they buy one unit, or many at the lower price?"
    },
    "row_total": {
      "type": "decimal",
      "required": true,
      "description": "How many × price each (RWF)"
    },
    "image_url": {
      "type": "text",
      "description": "Product image URL at the time of order (optional)"
    }
  }
}
